{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maestro Specialist Handoff v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "task_id",
    "role",
    "stage",
    "status",
    "base_sha",
    "candidate_sha",
    "summary",
    "changed_paths",
    "checks",
    "blockers",
    "known_risks",
    "next_action",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "ORCHESTRATOR",
        "ARCHITECT",
        "RESEARCHER",
        "BUILDER",
        "INDEPENDENT_REVIEWER",
        "DOMAIN_SPECIALIST"
      ]
    },
    "stage": {
      "enum": [
        "GROUNDING",
        "MOMENTUM",
        "MASTERY",
        "REPETITION"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "conditional"
      ]
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "outcome"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run"
            ]
          },
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "evidence_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
