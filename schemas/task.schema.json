{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maestro Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "task_id",
    "title",
    "outcome",
    "baseline",
    "owner",
    "reviewer",
    "scope",
    "exclusions",
    "dependencies",
    "acceptance",
    "evidence_required",
    "risk",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object",
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "git",
            "document",
            "artifact",
            "external"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "owner": {
      "enum": [
        "grounding",
        "momentum",
        "mastery",
        "orchestrator",
        "human"
      ]
    },
    "reviewer": {
      "enum": [
        "grounding",
        "mastery",
        "human"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "state": {
      "enum": [
        "INBOX",
        "GROUNDED",
        "READY",
        "IN_PROGRESS",
        "VERIFYING",
        "REVIEW",
        "ACCEPTED",
        "BLOCKED",
        "REWORK",
        "DEFERRED",
        "REJECTED",
        "SUPERSEDED"
      ]
    }
  }
}
